# 复制为 .env 后填入自己的密钥；.env 已被 .gitignore 忽略
# 大语言模型服务（任何兼容 OpenAI 接口的服务均可）
# 只有一把 key 就填 LLM_API_KEY；有多把（轮换 + 熔断）就填 LLM_API_KEYS，它会覆盖上面那行
LLM_API_KEY=sk-your-key-here
# 多个 key：逗号或换行分隔，例如 sk-aaa,sk-bbb,sk-ccc
LLM_API_KEYS=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat
# 可选
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.0
LLM_STREAM=true
# SerpApi 网页搜索工具
SERPAPI_API_KEY=your-serpapi-key-here
# 智能体默认参数
AGENT_MAX_STEPS=6
AGENT_TRACE_DIR=traces
# 上下文记忆：每个会话最多记住几轮（一轮 = 一次提问 + 一次回答）
AGENT_MEMORY_TURNS=5
# 网页同时保留多少个会话（超出按最近使用淘汰）
AGENT_MAX_SESSIONS=20
# 网页会话落盘目录（会话名与完整对话记录都放在这里）
AGENT_WEB_SESSION_DIR=traces/web-sessions
# 账号与配额（面向公网/收费时用）
AGENT_DB_PATH=traces/agentcode.db
# 登录 cookie 的签名密钥：不配则每次重启随机生成，用户会被强制重新登录
AGENT_SECRET_KEY=请填一串足够长的随机字符串
# 每个账号每天的 token 上限，超出直接拒绝
AGENT_DAILY_TOKEN_LIMIT=50000
# 每个用户每分钟最多请求次数（登录接口固定 10 次/分钟，防暴力试探）
AGENT_RATE_LIMIT_PER_MINUTE=30
# 每个用户同时最多几个任务在跑
AGENT_MAX_CONCURRENT_RUNS=2
# 单次任务的 token 上限，超出直接中断（避免一个任务吃掉整天额度）
AGENT_RUN_TOKEN_BUDGET=30000
# 某个 key 连续失败几次就临时摘掉，以及冷却多少秒后自动放回来
AGENT_KEY_FAILURE_THRESHOLD=3
AGENT_KEY_COOLDOWN_SECONDS=60
# 告警：不配 webhook 就只在日志里报，不往外推
# AGENT_ALERT_WEBHOOK=https://hooks.example.com/你的密钥
AGENT_ALERT_WINDOW_SECONDS=300
AGENT_ALERT_COOLDOWN_SECONDS=900
# 错误率阈值（0.5 = 一半失败就报）
AGENT_ALERT_ERROR_RATE=0.5
# 文件上传：单个文件上限、每个用户工作目录总量上限（字节）
AGENT_UPLOAD_MAX_BYTES=2097152
AGENT_UPLOAD_QUOTA_BYTES=52428800
# 抓指标用的令牌：容器里必须绑 0.0.0.0，于是"绑回环免登录"失效，
# 抓取端又走不了登录流程，所以留这个口子。不填则只能登录后看。
AGENT_METRICS_TOKEN=
# 数据留存：会话与代码文件留多少天。0 = 不自动清理（默认），删不删由用户自己决定。
# 配了就会在启动时扫一遍、之后每天扫一遍，只删文件，不动账号/账本/订单。
AGENT_RETENTION_DAYS=0
# 删除后先进回收站（会话、代码目录），保留多少天。0 = 不自动清理。
# 注销账号不进回收站（那是真删除），回收站也会跟着一起删干净。
AGENT_TRASH_DAYS=30
# 操作审计日志（谁在什么时候对谁做了什么）保留多少天。0 = 永久保留。
# 看日志：agentcode audit list；清过期：agentcode audit prune
AGENT_AUDIT_DAYS=180
# 服务通知（发给用户本人：套餐到期、额度用尽、账号被人猜密码、注销完成）。
# 渠道二选一：webhook 优先（POST 一段 JSON），其次 SMTP。都没配就只记台账、
# 不假装发出去——用 agentcode notify list 看台账，notify test <账号> 试一发。
# AGENT_NOTIFY_WEBHOOK=https://hooks.example.com/你的密钥
AGENT_SMTP_HOST=
# 465 = 隐式 TLS；587 等其它端口走明文 + STARTTLS
AGENT_SMTP_PORT=465
AGENT_SMTP_USER=
AGENT_SMTP_PASSWORD=
AGENT_SMTP_FROM=
# 套餐到期前几天提醒；同一账号多少分钟内失败几次登录就提醒本人
AGENT_NOTIFY_EXPIRING_DAYS=3
AGENT_NOTIFY_LOGIN_FAILURES=5
AGENT_NOTIFY_LOGIN_WINDOW_MINUTES=10
# 对外开放 API（POST /v1/run、GET /v1/me）。令牌必须由用户自己生成，
# 所以默认开着也不会被白用；不想让外部流量打进来就设 false。
AGENT_API_ENABLED=true
# 对外 API 的任务台账（异步任务的状态与结果）保留多少天；0 = 永久保留
AGENT_API_RUNS_DAYS=7
# 任务完成回调（POST /v1/run 带 callback_url）：异步任务跑完后主动 POST 结果。
# 签名密钥：留空则回落 AGENT_SECRET_KEY；两个都没配时，带 callback_url 的请求会被
# 直接拒绝（400）——发一条谁都验不了的请求比不发更糟。收方用 HMAC-SHA256 验签，
# 签名对象是 "时间戳.正文"，见 docs/api.md 第 5 节。
AGENT_CALLBACK_SECRET=
# 一个回调最多投递几次（含首次）；网络错误/5xx/429 才重试，4xx 直接放弃
AGENT_CALLBACK_MAX_ATTEMPTS=4
# 单次投递的超时（秒）
AGENT_CALLBACK_TIMEOUT=10
# 允许回调的端口；默认只放标准 Web 端口。要回调自建服务（比如 8080）就加上
AGENT_CALLBACK_PORTS=80,443
# 允许回调内网/本机地址：只给本地开发和测试用，公网部署别开（等于给别人一个内网探针）
AGENT_CALLBACK_ALLOW_PRIVATE=false
# 模型单价（分 / 百万 token）。不配 = 算不了钱，只能看 token。
# 例：DeepSeek 输入 ¥2/M、输出 ¥8/M → 填 200 和 800。
# 配好之后跑 `agentcode billing costs` 能看到花销和每个套餐的毛利。
AGENT_PRICE_INPUT_PER_MILLION=0
AGENT_PRICE_OUTPUT_PER_MILLION=0
# 自动备份：留空（默认）= 不自动备份。配了目录之后，服务启动时在后台查一次、
# 之后每小时查一次；距上一份超过 AGENT_BACKUP_INTERVAL_HOURS 才备一份，
# 只保留最近 AGENT_BACKUP_KEEP 份（只删自己生成的 agentcode-*.tar.gz，别的不碰）。
# 手动备份/演练：agentcode backup create | verify <包> | list | restore <包> --to <目录>
AGENT_BACKUP_DIR=
AGENT_BACKUP_INTERVAL_HOURS=24
AGENT_BACKUP_KEEP=7
# 是否允许网页端执行代码：公网部署保持 false（本地 CLI 不受此限制）
AGENT_ALLOW_CODE_TOOLS=false
# 受限代码执行（coding 智能体与 run_python 工具用）
AGENT_CODE_ROOT=traces/sandbox
AGENT_CODE_TIMEOUT=10
AGENT_CODE_OUTPUT_LIMIT=4000
# 代码执行后端：local=本机受限直跑（非沙箱，开发用）；docker=一次性容器隔离（公网用）
AGENT_EXECUTION_BACKEND=local
# 容器执行参数（AGENT_EXECUTION_BACKEND=docker 时才生效）
AGENT_DOCKER_IMAGE=python:3.13-slim
# docker 命令本身；用 WSL 里自装的 docker 引擎时写 "wsl -d Ubuntu -- docker"
AGENT_DOCKER_BINARY=docker
AGENT_DOCKER_MEMORY=256m
AGENT_DOCKER_CPUS=0.5
AGENT_DOCKER_PIDS_LIMIT=64
# 容器内跑代码的身份，默认 nobody（非 root）；留空则用镜像默认用户
AGENT_DOCKER_USER=65534:65534
# coding 智能体默认步数（写代码比闲聊需要更多步）
AGENT_CODING_STEPS=20
