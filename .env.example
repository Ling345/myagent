# 复制为 .env 后填入自己的密钥；.env 已被 .gitignore 忽略
# 大语言模型服务（任何兼容 OpenAI 接口的服务均可）
# 只有一把 key 就填 LLM_API_KEY；有多把（轮换 + 熔断）就填 LLM_API_KEYS，它会覆盖上面那行
LLM_API_KEY=sk-your-key-here
# 多个 key：逗号或换行分隔，例如 sk-aaa,sk-bbb,sk-ccc
LLM_API_KEYS=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_ID=deepseek-chat
# 可选
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.0
LLM_STREAM=true
# SerpApi 网页搜索工具
SERPAPI_API_KEY=your-serpapi-key-here
# 智能体默认参数
AGENT_MAX_STEPS=6
AGENT_TRACE_DIR=traces
# 上下文记忆：每个会话最多记住几轮（一轮 = 一次提问 + 一次回答）
AGENT_MEMORY_TURNS=5
# 网页同时保留多少个会话（超出按最近使用淘汰）
AGENT_MAX_SESSIONS=20
# 网页会话落盘目录（会话名与完整对话记录都放在这里）
AGENT_WEB_SESSION_DIR=traces/web-sessions
# 账号与配额（面向公网/收费时用）
AGENT_DB_PATH=traces/agentcode.db
# 登录 cookie 的签名密钥：不配则每次重启随机生成，用户会被强制重新登录
AGENT_SECRET_KEY=请填一串足够长的随机字符串
# 每个账号每天的 token 上限，超出直接拒绝
AGENT_DAILY_TOKEN_LIMIT=50000
# 每个用户每分钟最多请求次数（登录接口固定 10 次/分钟，防暴力试探）
AGENT_RATE_LIMIT_PER_MINUTE=30
# 每个用户同时最多几个任务在跑
AGENT_MAX_CONCURRENT_RUNS=2
# 单次任务的 token 上限，超出直接中断（避免一个任务吃掉整天额度）
AGENT_RUN_TOKEN_BUDGET=30000
# 某个 key 连续失败几次就临时摘掉，以及冷却多少秒后自动放回来
AGENT_KEY_FAILURE_THRESHOLD=3
AGENT_KEY_COOLDOWN_SECONDS=60
# 是否允许网页端执行代码：公网部署保持 false（本地 CLI 不受此限制）
AGENT_ALLOW_CODE_TOOLS=false
# 受限代码执行（coding 智能体与 run_python 工具用）
AGENT_CODE_ROOT=traces/sandbox
AGENT_CODE_TIMEOUT=10
AGENT_CODE_OUTPUT_LIMIT=4000
# 代码执行后端：local=本机受限直跑（非沙箱，开发用）；docker=一次性容器隔离（公网用）
AGENT_EXECUTION_BACKEND=local
# 容器执行参数（AGENT_EXECUTION_BACKEND=docker 时才生效）
AGENT_DOCKER_IMAGE=python:3.13-slim
# docker 命令本身；用 WSL 里自装的 docker 引擎时写 "wsl -d Ubuntu -- docker"
AGENT_DOCKER_BINARY=docker
AGENT_DOCKER_MEMORY=256m
AGENT_DOCKER_CPUS=0.5
AGENT_DOCKER_PIDS_LIMIT=64
# 容器内跑代码的身份，默认 nobody（非 root）；留空则用镜像默认用户
AGENT_DOCKER_USER=65534:65534
# coding 智能体默认步数（写代码比闲聊需要更多步）
AGENT_CODING_STEPS=20
